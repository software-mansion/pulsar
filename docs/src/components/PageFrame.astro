---
import Default from '@astrojs/starlight/components/PageFrame.astro';
import GTMBody from './gtm-body.astro';
import { SWM_URL, TERMS_URL, PULSAR_PRIVACY_URL, SWM_PRIVACY_URL } from '../data/legal';
const currentYear = new Date().getFullYear();
---

<GTMBody />
<Default {...Astro.props}>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
  <footer class="docs-footer">
    <p>
      &copy; {currentYear}
    <a href={SWM_URL} target="_blank" rel="noopener">Software Mansion</a>.
    Read about our
    <a href={SWM_PRIVACY_URL} target="_blank" rel="noopener"
      >Privacy Policy</a
    >.
    </p>
  </footer>
</Default>

<style>
  .docs-footer {
    border-top: 1px solid var(--sl-color-gray-5);
    padding: 1.25rem 1rem 2rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  .docs-footer p {
    margin: 0 auto;
    max-width: 48rem;
  }

  .docs-footer a {
    color: inherit;
    text-underline-offset: 2px;
    white-space: nowrap;
  }
 </style>
