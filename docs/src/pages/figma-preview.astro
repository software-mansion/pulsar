---
// The live preview is no longer part of the public documentation. It ships with
// Pulsar Studio (private repo: `studio/public/figma-preview/`, regenerated by
// `studio/scripts/build-figma-preview.mjs`) and is served from the Studio
// deployment at the apex — see the `preview` host in PulsarApp's
// `constants/env.ts` and the Figma plugin's `src/ui/lib/env.ts`, both of which
// already point there.
//
// This route stays behind as a redirect rather than 404ing, because it *was* the
// plugin's preview host until the preview moved to Studio, so share links and QR
// codes minted before then point here and their tokens still resolve on the
// server. Astro's `redirects` config can't do the job: it emits a meta-refresh
// that drops the query string, and the docs site is static on GitHub Pages, so
// there is no server-side redirect to forward `?token=` with. Hence the script.
const TARGET = 'https://pulsar.swmansion.com/figma-preview/';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Was never meant to be indexed, and a redirect stub even less so. Also
        filtered out of the sitemap in astro.config.mjs. */}
    <meta name="robots" content="noindex" />
    <title>Pulsar live preview has moved</title>
    <link rel="canonical" href={TARGET} />
    <script is:inline>
      // Carry the query string over — an old share link is worthless without its
      // ?token=. `replace` so Back doesn't bounce the user straight back here.
      location.replace(
        'https://pulsar.swmansion.com/figma-preview/' + location.search + location.hash
      );
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${TARGET}`} />
    </noscript>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        font-family: system-ui, -apple-system, sans-serif;
        text-align: center;
        color: #001a72;
      }
    </style>
  </head>
  <body>
    {/* Only ever seen with JS disabled, or if the redirect is slow. */}
    <p>
      The Pulsar live preview has moved to <a href={TARGET}>pulsar.swmansion.com/figma-preview/</a>.
    </p>
  </body>
</html>
