# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # Linkage is env-driven so CI can build with and without frameworks
  # (USE_FRAMEWORKS unset => static libs; 'static'/'dynamic' => use_frameworks!).
  linkage = ENV['USE_FRAMEWORKS']
  unless linkage.nil?
    Pod::UI.puts "Configuring Pods with #{linkage}ally linked frameworks".green
    use_frameworks! :linkage => linkage.to_sym
  end

  if ENV['USE_LOCAL_PULSAR_IOS'] == '1'
    # The plugin depends on `PulsarHaptics = <iosPodVersion>`, which is decoupled
    # from — and can lag — the iOS SDK release version the local `iOS/Pulsar`
    # podspec advertises. Pin the local pod to the plugin's expected version so
    # CocoaPods resolves them together. sdk-versions.json is the single source.
    require 'json'
    sdk_versions = JSON.parse(File.read(File.join(__dir__, '..', '..', '..', 'sdk-versions.json')))
    pulsar_pod_version = sdk_versions['flutter']['pulsarCore']['iosPodVersion']
    ENV['PULSAR_HAPTICS_POD_VERSION'] = pulsar_pod_version
    Pod::UI.puts "Using local PulsarHaptics pod from iOS/Pulsar (pinned to #{pulsar_pod_version})".green
    pod 'PulsarHaptics', :path => '../../../iOS/Pulsar'
  else
    Pod::UI.puts 'Using published PulsarHaptics pod from CocoaPods'.green
  end

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
